{
 "title": "RAGOps Monitoring",
 "uid": "ragops",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Requests / sec",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (endpoint) (rate(ragops_requests_total[1m]))",
     "legendFormat": "{{endpoint}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Error rate",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum(rate(ragops_requests_total{status=\"error\"}[5m])) / sum(rate(ragops_requests_total[5m]))",
     "legendFormat": "errors",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Latency p95 (s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ragops_request_latency_seconds_bucket{endpoint=\"ask\"}[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Prediction distribution (answered vs no answer)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (outcome) (increase(ragops_answers_total[10m]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "Groundedness (avg)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "rate(ragops_groundedness_sum[5m]) / rate(ragops_groundedness_count[5m])",
     "legendFormat": "groundedness",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "Top retrieval score (avg) - drift signal",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "rate(ragops_top_retrieval_score_sum[5m]) / rate(ragops_top_retrieval_score_count[5m])",
     "legendFormat": "top score",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "title": "User feedback (actual labels)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum by (label) (ragops_feedback_total)",
     "legendFormat": "{{label}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "title": "Helpful answers ratio",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum(ragops_feedback_total{label=\"up\"}) / sum(ragops_feedback_total)",
     "legendFormat": "helpful",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Drift detected (1 = yes, refresh via GET /drift)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "ragops_drift_detected",
     "legendFormat": "drift",
     "refId": "A"
    }
   ]
  }
 ]
}